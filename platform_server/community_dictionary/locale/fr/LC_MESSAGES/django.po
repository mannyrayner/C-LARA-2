msgstr "Brouillon"

msgid "Drafts and feedback are private and kept for 30 days unless cleared earlier. Shared entries remain in the dictionary."
msgstr "Les brouillons et les commentaires sont privés et conservés pendant 30 jours, sauf si vous les effacez avant. Les entrées partagées restent dans le dictionnaire."

msgid "Edit my text"
msgstr "Modifier mon texte"

msgid "Feedback and voice options"
msgstr "Options des commentaires et de la voix"

msgid "Feedback ready"
msgstr "Commentaires disponibles"

msgid "Help me practise writing"
msgstr "M’aider à pratiquer l’écrit"

msgid "I agree to send this picture and my writing to OpenAI and pay the estimated cost shown here."
msgstr "J’accepte d’envoyer cette image et mon texte à OpenAI et de payer le coût estimé indiqué ici."

msgid "If progress has stopped"
msgstr "Si le traitement semble arrêté"

msgid "In progress"
msgstr "En cours"

msgid "Language for explanations"
msgstr "Langue des explications"

msgid "My description"
msgstr "Ma description"

