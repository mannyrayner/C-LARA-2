msgid "%(words)s words / forms · %(total)s candidate recordings"
msgstr "%(words)s mots / formes · %(total)s enregistrements candidats"

msgid "Earlier candidates"
msgstr "Candidats précédents"

msgid "Further candidate batches"
msgstr "Lots de candidats supplémentaires"

msgid "No usable recording was produced. Existing audio is unchanged."
msgstr "Aucun enregistrement utilisable n’a été produit. L’audio existant est inchangé."

msgid "More candidates for this item"
msgstr "Candidats supplémentaires pour cet élément"

msgid "Estimate more candidates"
msgstr "Estimer des candidats supplémentaires"

msgid "Earlier previews are kept. A new estimate must be approved before generating more audio."
msgstr "Les aperçus précédents sont conservés. Une nouvelle estimation doit être approuvée avant de générer davantage d’audio."
