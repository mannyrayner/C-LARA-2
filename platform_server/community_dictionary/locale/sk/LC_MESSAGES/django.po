msgstr "Nastavenia slovníka boli uložené."

#: community_dictionary/views.py:524
msgid "Choose an existing account other than the owner, and a valid role."
msgstr "Vyberte existujúci účet odlišný od vlastníka a platnú rolu."

#: community_dictionary/views.py:535
msgid ""
"Membership retained. Use the status controls to reactivate an inactive "
"member."
msgstr ""
"Členstvo zostalo zachované. Na opätovnú aktiváciu neaktívneho člena použite "
"ovládacie prvky stavu."

#: community_dictionary/views.py:539
msgid "Invite as a member first, then propose the role change."
msgstr "Najprv pozvite osobu ako člena a potom navrhnite zmenu roly."

#: community_dictionary/views.py:544
msgid "Invitation saved. No email is sent."
msgstr "Pozvanie bolo uložené. E-mail sa neodosiela."

#: community_dictionary/views.py:546
msgid "Use Make inactive. Membership and contribution rights are retained."
msgstr ""
"Použite Deaktivovať. Členstvo a práva prispievateľa zostávajú zachované."

#: community_dictionary/views.py:552
msgid "Name the partnership and choose at least one other dictionary member."
msgstr "Pomenujte partnerstvo a vyberte aspoň jedného ďalšieho člena slovníka."

#: community_dictionary/views.py:570
