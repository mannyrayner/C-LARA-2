#: community_dictionary/templates/community_dictionary/photo_study.html:18
msgid ""
"The result could not be recovered. It may still have incurred a provider "
"charge. This attempt will not be sent again automatically."
msgstr ""
"Výsledok sa nepodarilo obnoviť. Poskytovateľ ho mohol aj tak spoplatniť. "
"Tento pokus sa automaticky neodošle znova."

#: community_dictionary/templates/community_dictionary/audio_study.html:15
msgid "The audio is being generated. Refresh this page in a moment."
msgstr "Zvuková nahrávka sa generuje. O chvíľu obnovte túto stránku."

#: community_dictionary/templates/community_dictionary/audio_study.html:15
#: community_dictionary/templates/community_dictionary/photo_study.html:18
