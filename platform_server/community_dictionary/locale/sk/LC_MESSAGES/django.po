msgid "choose another category."
msgstr "vyberte inú kategóriu."

#: community_dictionary/templates/community_dictionary/practice.html:23
msgid "Start flashcards"
msgstr "Spustiť kartičky"

#: community_dictionary/templates/community_dictionary/practice.html:25
msgid "Picture crossword"
msgstr "Obrázková krížovka"

#: community_dictionary/templates/community_dictionary/practice.html:25
msgid ""
"Use the pictures to fill in the words. Choose a clue, then type its answer."
msgstr ""
"Pomocou obrázkov doplňte slová. Vyberte nápovedu a potom napíšte odpoveď."

