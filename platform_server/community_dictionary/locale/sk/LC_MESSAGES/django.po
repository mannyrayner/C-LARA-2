msgstr "Obnoviť možno iba zdieľanú schválenú textovú časť."

#: community_dictionary/views.py:319
msgid "This component changed. Reload before restoring a version."
msgstr "Táto časť sa zmenila. Pred obnovením verzie znova načítajte stránku."

#: community_dictionary/views.py:329
msgid "Choose an accepted picture."
msgstr "Vyberte schválený obrázok."

#: community_dictionary/views.py:334
