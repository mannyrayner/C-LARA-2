msgstr "Okamžite schváliť môj obrázok"

#: community_dictionary/templates/community_dictionary/add_picture.html:20
msgid "Your picture will be sent for review by an editor."
msgstr "Váš obrázok bude odoslaný redaktorovi na kontrolu."

