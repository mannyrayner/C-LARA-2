msgstr "Slovník je skrytý v hlavnom zozname."

#: community_dictionary/views.py:456
msgid "Dictionary visible in the main list again."
msgstr "Slovník je znova viditeľný v hlavnom zozname."

#: community_dictionary/views.py:485
